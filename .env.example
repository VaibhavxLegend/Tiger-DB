# TigerGraph Connection Configuration
TG_HOST=https://your-instance.tgcloud.io
TG_TGCLOUD=true
TG_API_TOKEN=your-api-token-here

# Anthropic Configuration (for LangGraph agent)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# MCP Server Settings
TG_LOG_TOOL_CALLS=true
TG_LOG_CALLER_IDENTITY=profile

# Optional: OpenAI (if using as alternative to Anthropic)
# OPENAI_API_KEY=sk-your-api-key-here
