# Copy this file to .env and fill in your values.
# Never commit the real .env file — it is in .gitignore.

# ── TigerGraph ──────────────────────────────────────────────────────────────
# Full URL including scheme, e.g. https://<workspace-id>.tg-<org>.i.tgcloud.io
TG_HOST=https://your-workspace.tg-xxxxxxxx.i.tgcloud.io

# Graph name as created in TigerGraph (must match create_graph.gsql)
TG_GRAPH_NAME=FraudInvestigation

# API token generated from TigerGraph Cloud console → Admin → Security → Tokens
# Leave empty to use username/password authentication instead
TG_API_TOKEN=

# Set to "true" when connecting to TigerGraph Savanna Cloud
TG_TGCLOUD=true

# ── Anthropic (optional — system runs without it) ───────────────────────────
# Only needed if you enable LLM-assisted investigation nodes
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=your_google_api_key_here  # Required for Gemini LLM nodes (assessment, explain, evidence)

# ── Gemini LLM (optional — for structured LLM nodes) ────────────────────────
# Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
